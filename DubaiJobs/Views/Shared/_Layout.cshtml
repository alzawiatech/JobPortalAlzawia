@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    var currentUser = User.Identity?.Name;
    var postJobReturnUrl = Url.Action("Privacy", "Home") ?? "/";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="description" content="DubaiJobs - Find your dream job today." />

    <title>@ViewData["Title"] - DubaiJobs</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=Sora:wght@300;400;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <!-- Authentication Navigation CSS -->
    <style>
            /* Desktop authentication menu item */
            .nav-auth-item {
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .nav-auth-item a {
                    white-space: nowrap;
                }

            .nav-user-name {
                font-weight: 600;
                color: inherit;
                max-width: 140px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .nav-logout-form {
                display: inline-flex;
                margin: 0;
            }

            .nav-logout-link {
                border: none;
                background: none;
                padding: 0;
                color: inherit;
                font: inherit;
                cursor: pointer;
                text-decoration: none;
            }

                .nav-logout-link:hover {
                    color: #2563eb;
                }

            /* Mobile authentication links */
            .mobile-auth-section {
                display: flex;
                flex-direction: column;
                gap: 12px;
                padding: 12px 20px;
            }

                .mobile-auth-section a {
                    display: block;
                }

            .mobile-user-name {
                font-weight: 700;
                overflow-wrap: anywhere;
            }

            .mobile-logout-form {
                margin: 0;
                width: 100%;
            }

            .mobile-logout-button {
                width: 100%;
                cursor: pointer;
                font: inherit;
            }

            /* Keep desktop navigation tidy on smaller screens */
            @@media (max-width: 1100px) and (min-width: 769px) {
                .nav-user-name {
                    max-width: 90px;
                    font-size: 13px;
                }
            }

            /* Mobile menu */
            @@media (max-width: 768px) {
                .nav-auth-item {
                    display: none;
                }

                .mobile-auth-section {
                    display: flex;
                }
            }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ================= HEADER ================= -->

    <header id="header" role="banner">

        <div class="container">

            <nav class="nav-inner" aria-label="Main navigation">

                <!-- Logo -->
                <a asp-controller="Home"
                   asp-action="Index"
                   class="logo"
                   aria-label="DubaiJobs Home">

                    <div class="logo-mark" aria-hidden="true">D</div>

                    <span class="logo-name">
                        Dubai<span>Jobs</span>
                    </span>

                </a>

                <!-- Desktop Navigation -->
                <ul class="nav-links" role="list">

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="home">
                            Home
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Jobs"
                           asp-action="Index">
                            Jobs
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="categories">
                            Categories
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="companies">
                            Companies
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="contact">
                            Contact
                        </a>
                    </li>

                    <!-- Login/Register OR Username/Logout -->
                    <li class="nav-auth-item">

                        @if (isLoggedIn)
                        {
                            <span class="nav-user-name" title="@currentUser">
                                @currentUser
                            </span>

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  asp-route-returnUrl="/"
                                  method="post"
                                  class="nav-logout-form">

                                <button type="submit" class="nav-logout-link">
                                    Logout
                                </button>

                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login">
                                Login / Register
                            </a>
                        }

                    </li>

                </ul>

                <!-- Header Buttons -->
                <div class="nav-cta">

                    <a asp-controller="Jobs"
                       asp-action="Index"
                       class="btn btn-outline">
                        Browse Jobs
                    </a>

                    @if (isLoggedIn)
                    {
                        <a asp-controller="Home"
                           asp-action="Privacy"
                           class="btn btn-primary">
                            Post a Job
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-returnUrl="@postJobReturnUrl"
                           class="btn btn-primary">
                            Post a Job
                        </a>
                    }

                </div>

                <!-- Mobile Hamburger -->
                <button class="hamburger"
                        id="hamburger"
                        type="button"
                        aria-label="Toggle mobile menu"
                        aria-expanded="false"
                        aria-controls="mobile-nav">

                    <span></span>
                    <span></span>
                    <span></span>

                </button>

            </nav>

        </div>

        <!-- Mobile Navigation -->
 
        <nav class="mobile-nav"
             id="mobile-nav"
             aria-label="Mobile navigation">

            <a asp-controller="Home" asp-action="Index">Home</a>

            <a asp-controller="Jobs" asp-action="Index">Jobs</a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="categories">
                Categories
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="companies">
                Companies
            </a>

            @* <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="about">
                About
            </a> *@

            <!-- Contact -->
            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="contact">
                Contact
            </a>

            <!-- Mobile Login/Register OR Username/Logout -->
            <div class="mobile-auth-section">

                @if (isLoggedIn)
                {
                    <span class="mobile-user-name">
                        Hello, @currentUser!
                    </span>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          method="post"
                          class="mobile-logout-form">

                        <button type="submit"
                                class="btn btn-outline mobile-logout-button">
                            Logout
                        </button>

                    </form>
                }
                else
                {
                    <span class="mobile-user-name">
                        Hello! Welcome to DubaiJobs.
                    </span>

                    <button type="button"
                            class="btn btn-outline mobile-logout-button rounded-0 border"
                            onclick="window.location.href='@Url.Page("/Account/Login", new { area = "Identity" })'">
                        Login / Register
                    </button>
                }

            </div>

        </nav>


    </header>


    <!-- ================= PAGE CONTENT ================= -->

    <main role="main">

        @RenderBody()

    </main>


    <!-- ================= FOOTER ================= -->

    <footer id="footer" role="contentinfo">

        <div class="container">

            <div class="footer-grid">

                <!-- Brand -->
                <div>

                    <div class="footer-brand-logo">

                        <div class="logo-mark" aria-hidden="true">D</div>

                        <span class="logo-name">
                            Dubai<span>Jobs</span>
                        </span>

                    </div>

                    <p class="footer-desc">
                        Connecting ambitious professionals with
                        world-class companies. Your career journey
                        starts here.
                    </p>

                    <div class="social-links"
                         aria-label="Social media links">

                        <a href="#" class="social-link"
                           aria-label="Twitter">𝕏</a>

                        <a href="#" class="social-link"
                           aria-label="LinkedIn">in</a>

                        <a href="#" class="social-link"
                           aria-label="Facebook">f</a>

                        <a href="#" class="social-link"
                           aria-label="Instagram">◉</a>

                    </div>

                </div>


                <!-- Job Seekers -->
                <div>

                    <h3 class="footer-col-title">For Job Seekers</h3>

                    <ul class="footer-links" role="list">

                        <li>
                            <a asp-controller="Jobs" asp-action="Index">
                                Browse Jobs
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="categories">
                                Job Categories
                            </a>
                        </li>

                        <li><a href="#">Career Advice</a></li>

                        <li><a href="#">Resume Builder</a></li>

                        <li><a href="#">Salary Guide</a></li>

                    </ul>

                </div>


                <!-- Employers -->
                <div>

                    <h3 class="footer-col-title">For Employers</h3>

                    <ul class="footer-links" role="list">

                        <li>
                            <a asp-controller="Jobs" asp-action="Create">
                                Post a Job
                            </a>
                        </li>

                        <li><a href="#">Talent Search</a></li>

                        <li><a href="#">Pricing Plans</a></li>

                        <li><a href="#">Employer Branding</a></li>

                        <li><a href="#">Recruitment API</a></li>

                    </ul>

                </div>


                <!-- Company -->
                <div>

                    <h3 class="footer-col-title">Company</h3>

                    <ul class="footer-links" role="list">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="about">
                                About Us
                            </a>
                        </li>

                        <li>
                            @if (isLoggedIn)
                            {
                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      asp-route-returnUrl="/"
                                      method="post">

                                    <button type="submit"
                                            class="nav-logout-link">
                                        Logout
                                    </button>

                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity"
                                   asp-page="/Account/Login">
                                    Login
                                </a>
                            }
                        </li>

                        <li>
                            <a asp-controller="Home" asp-action="contact">
                                Contact
                            </a>
                        </li>

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="contact">
                                Contact
                            </a>
                        </li>

                        <li><a href="#">Blog</a></li>

                    </ul>

                </div>

            </div>


            <!-- Footer Bottom -->
            <div class="footer-bottom">

                <p class="footer-copy">

                    © @DateTime.Now.Year

                    <a asp-controller="Home" asp-action="Index">
                        DubaiJobs
                    </a>.

                    All rights reserved.

                </p>

                <div class="footer-bottom-links">

                    <a asp-controller="Home" asp-action="Privacy">
                        Privacy Policy
                    </a>

                    <a href="#">Terms of Service</a>

                    <a href="#">FAQs</a>

                </div>

            </div>

        </div>

    </footer>


    <!-- Scroll To Top -->
    <button id="scroll-top"
            type="button"
            aria-label="Scroll back to top"
            title="Scroll to top">

        <svg width="18"
             height="18"
             fill="none"
             stroke="currentColor"
             viewBox="0 0 24 24"
             stroke-width="2.5"
             aria-hidden="true">

            <polyline points="18 15 12 9 6 15" />

        </svg>

    </button>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
