@model IEnumerable<DubaiJobs.Models.PostJobs>

@using System
@using System.Linq

@{
    ViewData["Title"] = "Browse Jobs";
    var jobs = Model ?? Enumerable.Empty<DubaiJobs.Models.PostJobs>();
    var jobList = jobs.ToList();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/browse-jobs.css" asp-append-version="true" />
}

<section class="browse-hero">
    <div class="browse-container">
        <span class="hero-badge">UAE's Premier Career Portal</span>
        <h1>Find your next opportunity</h1>
        <p>Discover jobs that match your skills, experience, and career goals across Dubai &amp; the UAE.</p>

        <div class="quick-search">
            <div class="search-input-group">
                <i class="bi bi-search"></i>
                <input type="text" id="keywordSearch"
                       placeholder="Job title, company, or keyword" />
            </div>

            <div class="search-divider"></div>

            <div class="search-input-group">
                <i class="bi bi-geo-alt"></i>
                <input type="text" id="locationSearch"
                       placeholder="City or location (e.g. Dubai Marina)" />
            </div>

            <button type="button" id="searchButton">
                Search Jobs
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</section>

<section class="browse-section">
    <div class="browse-container">

        <div class="browse-heading">
            <div>
                <h2>Explore Jobs</h2>
                <p>Find the right opportunity for your career.</p>
            </div>

            <button type="button" class="mobile-filter-btn" id="openFilters">
                <i class="bi bi-sliders"></i> Filters
            </button>
        </div>

        <div class="browse-layout">

            <!-- FILTER SIDEBAR -->
            <aside class="filter-sidebar" id="filterSidebar">
                <div class="filter-heading">
                    <h3><i class="bi bi-funnel"></i> Filters</h3>

                    <div class="filter-header-actions">
                        <button type="button" id="clearFilters">Clear all</button>

                        <button type="button" class="close-filter"
                                id="closeFilters" aria-label="Close filters">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="filter-group">
                    <h4>Employment Type</h4>
                    <div class="checkbox-list">
                        @foreach (var type in new[]
                        {
                            "Full-time", "Part-time", "Contract",
                            "Internship", "Freelance"
                        })
                        {
                            <label class="custom-checkbox">
                                <input type="checkbox" class="job-filter"
                                       data-filter="employment" value="@type" />
                                <span>@type</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <h4>Workplace</h4>
                    <div class="checkbox-list">
                        @foreach (var workplace in new[] { "On-site", "Remote", "Hybrid" })
                        {
                            <label class="custom-checkbox">
                                <input type="checkbox" class="job-filter"
                                       data-filter="workplace" value="@workplace" />
                                <span>@workplace</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="filter-group">
                    <h4>Job Category</h4>
                    <input type="text" id="categoryFilter"
                           placeholder="e.g. IT, Finance, Marketing"
                           class="filter-textbox" />
                </div>

                <div class="filter-group">
                    <h4>Salary Range (AED)</h4>
                    <div class="salary-inputs">
                        <input type="number" id="minSalary"
                               placeholder="Min" class="filter-textbox" />
                        <span>–</span>
                        <input type="number" id="maxSalary"
                               placeholder="Max" class="filter-textbox" />
                    </div>
                </div>

                <button type="button" class="apply-filter-btn" id="applyFilters">
                    Apply Filters
                </button>
            </aside>

            <!-- JOB LIST -->
            <main class="job-list-section">

                <div class="job-list-header">
                    <div class="results-count">
                        <strong id="jobCount">@jobList.Count</strong>
                        <span>jobs available</span>
                    </div>

                    <div class="sort-wrapper">
                        <label for="sortJobs">Sort by:</label>
                        <select id="sortJobs">
                            <option value="recent">Most Recent</option>
                            <option value="salaryHigh">Salary: High to Low</option>
                            <option value="salaryLow">Salary: Low to High</option>
                        </select>
                    </div>
                </div>

                <div id="jobList" class="job-list">

                    @if (jobList.Any())
                    {
                        @foreach (var job in jobList)
                        {
                            var companyInitials = string.IsNullOrWhiteSpace(job.CompanyName)
                                ? "DJ"
                                : string.Concat(job.CompanyName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(x => x.Substring(0, 1).ToUpper()));

                            <article class="job-item"
                                     data-id="@job.Id"
                                     data-title="@job.JobTitle"
                                     data-company="@job.CompanyName"
                                     data-location="@job.Location"
                                     data-employment="@job.EmploymentType"
                                     data-workplace="@job.Workplace"
                                     data-category="@job.Category"
                                     data-minsalary="@job.SalaryMin"
                                     data-maxsalary="@job.SalaryMax"
                                     data-posted="@job.PostedAt.ToString("yyyy-MM-dd")">

                                <div class="job-item-top">
                                    <div class="job-company-logo">
                                        @if (!string.IsNullOrEmpty(job.CompanyLogo))
                                        {
                                            <img src="@job.CompanyLogo" alt="@job.CompanyName Logo"
                                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                            <i class="bi bi-buildings" style="display:none;"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-buildings"></i>
                                        }
                                    </div>

                                    <div class="job-main-info">
                                        <button type="button" class="job-title-btn">
                                            @job.JobTitle
                                        </button>

                                        <div class="job-department">
                                            <span class="company-name">@job.CompanyName</span>

                                            @if (!string.IsNullOrWhiteSpace(job.Department))
                                            {
                                                <span class="dept-dot">•</span>
                                                <span>@job.Department</span>
                                            }
                                        </div>
                                    </div>

                                    <span class="job-status">@job.EmploymentType</span>
                                </div>

                                <div class="job-meta">
                                    <span>
                                        <i class="bi bi-geo-alt"></i>
                                        @(string.IsNullOrWhiteSpace(job.Location) ? "Dubai, UAE" : job.Location)
                                    </span>
                                    <span>
                                        <i class="bi bi-laptop"></i>
                                        @job.Workplace
                                    </span>
                                    <span>
                                        <i class="bi bi-clock"></i>
                                        @job.PostedAt.ToString("dd MMM yyyy")
                                    </span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(job.Description))
                                {
                                    <div class="job-description-preview">
                                        @job.Description
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(job.Category) ||
                                     !string.IsNullOrWhiteSpace(job.Skills))
                                {
                                    <div class="job-category">
                                        @if (!string.IsNullOrWhiteSpace(job.Category))
                                        {
                                            <span class="tag-category">@job.Category</span>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(job.Skills))
                                        {
                                            foreach (var skill in job.Skills
                                                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                                                .Take(3))
                                            {
                                                <span class="tag-skill">@skill.Trim()</span>
                                            }
                                        }
                                    </div>
                                }

                                <div class="job-item-bottom">
                                    <div class="job-salary">
                                        <small>AED</small>
                                        @job.SalaryMin.ToString("N0") – @job.SalaryMax.ToString("N0")
                                        <span class="salary-period">/ mo</span>
                                    </div>

                                    <button type="button" class="view-job-btn">
                                        View Details
                                        <i class="bi bi-arrow-right"></i>
                                    </button>
                                </div>

                                <!-- JOB DETAILS TEMPLATE -->
                                <template class="job-details-template">
                                    <div class="detail-header-card">
                                        <div class="detail-company">
                                            <div class="job-company-logo">
                                                @if (!string.IsNullOrEmpty(job.CompanyLogo))
                                                {
                                                    <img src="@job.CompanyLogo" alt="@job.CompanyName Logo"
                                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                                    <i class="bi bi-buildings" style="display:none;"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-buildings"></i>
                                                }
                                            </div>

                                            <div>
                                                <h2>@job.JobTitle</h2>
                                                <p class="detail-company-name">
                                                    @job.CompanyName
                                                    @if (!string.IsNullOrWhiteSpace(job.Department))
                                                    {
                                                        <span> • @job.Department</span>
                                                    }
                                                </p>
                                            </div>
                                        </div>

                                        <div class="detail-meta">
                                            <span class="meta-pill">
                                                <i class="bi bi-geo-alt"></i>
                                                @(string.IsNullOrWhiteSpace(job.Location) ? "Dubai, UAE" : job.Location)
                                            </span>
                                            <span class="meta-pill">
                                                <i class="bi bi-briefcase"></i> @job.EmploymentType
                                            </span>
                                            <span class="meta-pill">
                                                <i class="bi bi-laptop"></i> @job.Workplace
                                            </span>
                                            <span class="meta-pill">
                                                <i class="bi bi-calendar3"></i>
                                                Posted @job.PostedAt.ToString("dd MMM yyyy")
                                            </span>
                                        </div>

                                        <div class="detail-salary-box">
                                            <div>
                                                <span class="salary-label">Estimated Monthly Salary</span>
                                                <div class="salary-amount">
                                                    AED @job.SalaryMin.ToString("N0") – @job.SalaryMax.ToString("N0")
                                                </div>
                                            </div>

                                            <a class="detail-apply-btn top-apply"
                                               href="@Url.Action("Apply", "ApplyJob", new { jobId = job.Id })">
                                                Apply Now <i class="bi bi-box-arrow-up-right"></i>
                                            </a>
                                        </div>
                                    </div>

                                    <div class="detail-body">
                                        <h3>Job Description</h3>
                                        <div class="job-full-description">
                                            @job.Description
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(job.Category))
                                        {
                                            <h3>Job Category</h3>
                                            <p><span class="tag-category">@job.Category</span></p>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(job.Skills))
                                        {
                                            <h3>Required Skills</h3>
                                            <div class="detail-skills-wrap">
                                                @foreach (var skill in job.Skills
                                                    .Split(',', StringSplitOptions.RemoveEmptyEntries))
                                                {
                                                    <span class="tag-skill">@skill.Trim()</span>
                                                }
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(job.CompanyWebsite))
                                        {
                                            <h3>Company Website</h3>
                                            <p>
                                                <a href="@job.CompanyWebsite"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="company-link">
                                                    <i class="bi bi-globe"></i> Visit Company Website
                                                </a>
                                            </p>
                                        }
                                    </div>

                                    <div class="detail-apply-area">
                                        <div>
                                            <strong>Ready to take the next step?</strong>
                                            <p>Submit your application directly to @job.CompanyName.</p>
                                        </div>

                                        <a class="detail-apply-btn"
                                           href="@Url.Action("Apply", "ApplyJob", new { jobId = job.Id })">
                                            Apply Now <i class="bi bi-arrow-right"></i>
                                        </a>
                                    </div>
                                </template>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="no-jobs">
                            <div class="empty-icon"><i class="bi bi-briefcase"></i></div>
                            <h3>No jobs available</h3>
                            <p>There are currently no job listings in the database.</p>
                        </div>
                    }
                </div>

                <div id="noJobs" class="no-jobs" style="display:none;">
                    <div class="empty-icon"><i class="bi bi-search"></i></div>
                    <h3>No matching jobs found</h3>
                    <p>Try adjusting your keywords, location, or clearing active filters.</p>
                </div>

                <!-- PAGINATION -->
                <nav class="job-pagination" id="jobPagination"
                     aria-label="Job listing pages">
                    <button type="button" id="prevPage" class="page-btn">
                        <i class="bi bi-chevron-left"></i> Previous
                    </button>

                    <div id="pageNumbers" class="page-numbers"></div>

                    <button type="button" id="nextPage" class="page-btn">
                        Next <i class="bi bi-chevron-right"></i>
                    </button>
                </nav>

                <div class="pagination-info" id="paginationInfo"></div>
            </main>

            <!-- DESKTOP DETAILS PANEL -->
            <aside class="job-detail-panel" id="jobDetailPanel">
                <div class="detail-placeholder" id="detailPlaceholder">
                    <div class="empty-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>
                    <h3>Select a job to view details</h3>
                    <p>
                        Click on any job listing to read the full role description,
                        requirements, and application details.
                    </p>
                </div>

                <div id="detailContent"></div>
            </aside>

        </div>
    </div>
</section>

<!-- MOBILE JOB DETAILS -->
<div class="mobile-detail-overlay" id="mobileDetailOverlay">
    <div class="mobile-detail-header">
        <strong>Job Details</strong>
        <button type="button" id="closeJobDetails" aria-label="Close details">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>
    <div id="mobileDetailContent"></div>
</div>

<script src="~/js/browse-jobs.js" asp-append-version="true"></script>