    <!-- ════════════════════════════════════════════
         HOW IT WORKS
    ════════════════════════════════════════════ -->
    <section id="how-it-works" aria-labelledby="how-title">
        <div class="container">
            <div class="section-header">
                <div class="section-label" data-aos="fade-up">Simple Process</div>
                <h2 class="section-title" id="how-title" data-aos="fade-up" data-aos-delay="50">How TalentHub Works</h2>
                <p class="section-subtitle" data-aos="fade-up" data-aos-delay="100">
                    Your path from job seeker to hired — in
                    four simple steps.
                </p>
            </div>

            <div class="steps-grid">

                <div class="step-card" data-aos="fade-up" data-aos-delay="0">
                    <div class="step-number">01</div>
                    <div class="step-icon">👤</div>
                    <div class="step-title">Create Your Account</div>
                    <p class="step-desc">
                        Sign up in under 2 minutes. Build a professional profile that showcases your skills,
                        experience, and aspirations.
                    </p>
                </div>

                <div class="step-card" data-aos="fade-up" data-aos-delay="100">
                    <div class="step-number">02</div>
                    <div class="step-icon">🔎</div>
                    <div class="step-title">Search Jobs</div>
                    <p class="step-desc">
                        Use smart filters to find roles that match your skills, location preferences, and
                        salary expectations.
                    </p>
                </div>

                <div class="step-card" data-aos="fade-up" data-aos-delay="200">
                    <div class="step-number">03</div>
                    <div class="step-icon">📋</div>
                    <div class="step-title">Apply with Ease</div>
                    <p class="step-desc">
                        One-click apply using your saved profile. Track all applications from your personal
                        dashboard in real time.
                    </p>
                </div>

                <div class="step-card" data-aos="fade-up" data-aos-delay="300">
