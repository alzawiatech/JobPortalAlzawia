@{
    ViewData["Title"] = "Home Page";
}


    <section id="home" aria-labelledby="hero-title">
        <!-- Decorative blobs -->
        <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
        <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
        <div class="dots-grid" aria-hidden="true"></div>

        <div class="container">
            <div class="hero-content">

                <div class="hero-tag" data-aos="fade-down" data-aos-duration="600">
                    <span>✦</span> #1 Job Portal Platform in Dubai
                </div>

                <h1 class="hero-title" id="hero-title" data-aos="fade-up" data-aos-duration="700" data-aos-delay="100">
                    Find Your <em>Dream Job</em><br />Today
                </h1>

                <p class="hero-desc" data-aos="fade-up" data-aos-duration="700" data-aos-delay="200">
                    Discover thousands of opportunities from top companies across every industry. Your next chapter starts here.
                </p>

                <!-- Search Bar -->
                <div class="search-box" data-aos="fade-up" data-aos-duration="800" data-aos-delay="300" role="search">
                    <div class="search-field">
                        <span class="field-icon" aria-hidden="true">🔍</span>
                        <input type="text" placeholder="Job title or keyword" aria-label="Job title or keyword" />
                    </div>
                    <div class="search-field">
                        <span class="field-icon" aria-hidden="true">📍</span>
                        <input type="text" placeholder="City or remote" aria-label="Location" />
                    </div>
                    <div class="search-field">
                        <span class="field-icon" aria-hidden="true">📂</span>
                        <select aria-label="Job category">
                            <option value="">All Categories</option>
                            <option>Technology</option>
                            <option>Design & Creative</option>
                            <option>Marketing</option>
                            <option>Finance</option>
                            <option>Healthcare</option>
                            <option>Education</option>
                            <option>Engineering</option>
                            <option>Sales</option>
                        </select>
                    </div>
                    <button class="search-btn" type="submit" aria-label="Search jobs">
                        <span>Search Jobs</span>
                        <span aria-hidden="true">→</span>
                    </button>
                </div>

                <!-- Stats -->
                <div class="hero-stats" data-aos="fade-up" data-aos-duration="700" data-aos-delay="400">
                    <div class="stat-item">
                        <div class="stat-number">48K+</div>
                        <div class="stat-label">Active Jobs</div>
                    </div>
                    <div class="stat-divider" aria-hidden="true"></div>
                    <div class="stat-item">
                        <div class="stat-number">12K+</div>
                        <div class="stat-label">Companies</div>
                    </div>
                    <div class="stat-divider" aria-hidden="true"></div>
                    <div class="stat-item">
                        <div class="stat-number">2.3M+</div>
                        <div class="stat-label">Job Seekers</div>
                    </div>
                    <div class="stat-divider" aria-hidden="true"></div>
                    <div class="stat-item">
                        <div class="stat-number">98%</div>
                        <div class="stat-label">Success Rate</div>
                    </div>
                </div>

            </div>
        </div>
    </section>

