@* Employer dashboard view. Shared header/footer are rendered by _Layout.cshtml. *@

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<style>
    /* Employer dashboard additions – scoped to this page */
    #employer-dashboard {
        padding: calc(var(--nav-height) + var(--sp-10)) 0 var(--sp-16);
        background: var(--off-white);
        min-height: 70vh;
    }

    .ed-wrap {
        width: 100%;
    }

    .ed-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: var(--sp-8);
        flex-wrap: wrap;
    }

        .ed-heading .section-header {
            text-align: left;
            margin: 0;
        }

        .ed-heading .section-title {
            margin-bottom: .45rem;
        }

        .ed-heading .section-subtitle {
            margin: 0;
        }

    .ed-primary-btn {
        border: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .55rem;
        text-decoration: none;
    }

    .ed-stats {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .ed-stat {
        background: var(--surface,#fff);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        min-width: 0;
    }

    .ed-stat-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        color: var(--text-muted);
        font-size: .86rem;
    }

    .ed-stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: grid;
        place-items: center;
        background: rgba(249,115,22,.09);
        font-size: 1.15rem;
        flex: none;
    }

    .ed-stat strong {
        display: block;
        margin-top: .55rem;
        font: 700 1.8rem Sora,sans-serif;
        color: var(--text-dark);
    }

    .ed-stat small {
        color: var(--text-muted);
        font-size: .78rem;
    }

    .ed-panel {
        background: var(--surface,#fff);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .ed-tabs {
        display: flex;
        align-items: center;
        gap: .35rem;
        padding: .75rem;
        border-bottom: 1px solid var(--border);
        overflow-x: auto;
        scrollbar-width: thin;
    }

    .ed-tab {
        border: 0;
        background: transparent;
        color: var(--text-muted);
        padding: .8rem 1rem;
        border-radius: 9px;
        cursor: pointer;
        white-space: nowrap;
        font: 600 .92rem 'DM Sans',sans-serif;
    }

        .ed-tab.active {
            color: var(--text-dark);
            background: var(--off-white);
        }

        .ed-tab:focus-visible,
        .ed-btn:focus-visible,
        .ed-tab-action:focus-visible {
            outline: 3px solid rgba(249,115,22,.35);
            outline-offset: 2px;
        }

    .ed-view {
        display: none;
        padding: clamp(1rem,2.5vw,1.7rem);
    }

        .ed-view.active {
            display: block;
            animation: edFade .22s ease;
        }

    @@keyframes edFade {
        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ed-view-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.15rem;
    }

        .ed-view-head h2 {
            margin: 0;
            font: 700 1.15rem Sora,sans-serif;
            color: var(--text-dark);
        }

        .ed-view-head p {
            margin: .3rem 0 0;
            color: var(--text-muted);
            font-size: .88rem;
        }

    .ed-job-list {
        display: grid;
        gap: .85rem;
    }

    .ed-job {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 1rem;
        min-width: 0;
    }

    .ed-job-main {
        display: flex;
        align-items: center;
        gap: .85rem;
        min-width: 0;
    }

    .ed-job-icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--off-white);
        font-size: 1.3rem;
        flex: none;
    }

    .ed-job-copy {
        min-width: 0;
    }

        .ed-job-copy h3 {
            margin: 0 0 .25rem;
            font-size: .98rem;
            color: var(--text-dark);
            overflow-wrap: anywhere;
        }

        .ed-job-copy p {
            margin: 0;
            color: var(--text-muted);
            font-size: .84rem;
            overflow-wrap: anywhere;
        }

    .ed-job-meta {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1.2rem;
        flex-wrap: wrap;
    }

    .ed-meta {
        min-width: 65px;
    }

        .ed-meta span {
            display: block;
            color: var(--text-muted);
            font-size: .72rem;
            margin-bottom: .2rem;
        }

        .ed-meta strong {
            color: var(--text-dark);
            font-size: .84rem;
            font-weight: 600;
        }

    .ed-status {
        display: inline-flex;
        align-items: center;
        border-radius: 99px;
        padding: .32rem .65rem;
        font-size: .75rem;
        font-weight: 700;
        white-space: nowrap;
        background: rgba(22,163,74,.1);
        color: #15803d;
    }

        .ed-status.closed {
            background: rgba(100,116,139,.12);
            color: #64748b;
        }

        .ed-status.pending {
            background: rgba(234,179,8,.14);
            color: #a16207;
        }

    .ed-actions {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

    .ed-btn {
        border: 1px solid var(--border);
        background: var(--surface,#fff);
        color: var(--text-dark);
        border-radius: 8px;
        padding: .48rem .7rem;
        cursor: pointer;
        font: 600 .78rem 'DM Sans',sans-serif;
    }

        .ed-btn:hover {
            border-color: var(--accent);
            color: var(--accent);
        }

        .ed-btn.danger:hover {
            border-color: #dc2626;
            color: #dc2626;
        }

        .ed-btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }

    .ed-empty {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--text-muted);
        border: 1px dashed var(--border);
        border-radius: var(--radius-md);
    }

        .ed-empty strong {
            display: block;
            color: var(--text-dark);
            margin-bottom: .35rem;
        }

    .ed-form-layout {
        display: grid;
        grid-template-columns: minmax(0,1.65fr) minmax(250px,.85fr);
        gap: 1.25rem;
        align-items: start;
    }

    .ed-form-card, .ed-side-card {
        background: var(--surface,#fff);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: clamp(1rem,2.5vw,1.5rem);
        min-width: 0;
    }

        .ed-form-card h3 {
            font: 700 1.05rem Sora,sans-serif;
            margin: 0 0 1.15rem;
            color: var(--text-dark);
        }

        .ed-form-card .form-group {
            min-width: 0;
        }

        .ed-form-card input,
        .ed-form-card select,
        .ed-form-card textarea {
            max-width: 100%;
        }

        .ed-form-card textarea {
            min-height: 150px;
            resize: vertical;
        }

        .ed-form-card .form-hint {
            font-size: .78rem;
            color: var(--text-muted);
            margin-top: .35rem;
        }

    .ed-form-actions {
        display: flex;
        gap: .7rem;
        flex-wrap: wrap;
        margin-top: 1.4rem;
    }

        .ed-form-actions button {
            min-width: 145px;
        }

    .ed-side-card + .ed-side-card {
        margin-top: 1rem;
    }

    .ed-side-card h3 {
        font: 700 1.05rem Sora,sans-serif;
        margin: 0 0 .55rem;
        color: var(--text-dark);
    }

    .ed-side-card p {
        color: var(--text-muted);
        font-size: .87rem;
        line-height: 1.6;
        margin: .3rem 0 1rem;
    }

    .ed-preview {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        background: var(--off-white);
        overflow-wrap: anywhere;
    }

    .ed-preview-title {
        font-weight: 700;
        color: var(--text-dark);
    }

    .ed-preview-company {
        font-size: .82rem;
        color: var(--text-muted);
        margin: .2rem 0 .8rem;
    }

    .ed-preview-tags {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        margin-bottom: .7rem;
    }

    .ed-preview-tag {
        background: var(--surface,#fff);
        border: 1px solid var(--border);
        border-radius: 99px;
        padding: .25rem .55rem;
        font-size: .72rem;
        color: var(--text-body);
    }

    .ed-preview-pay {
        font-size: .83rem;
        color: var(--text-body);
    }

    .ed-message {
        display: none;
        padding: .8rem 1rem;
        border-radius: 9px;
        margin-bottom: 1rem;
        font-size: .88rem;
    }

        .ed-message.show {
            display: block;
        }

        .ed-message.success {
            background: rgba(22,163,74,.1);
            color: #15803d;
        }

        .ed-message.error {
            background: rgba(220,38,38,.1);
            color: #b91c1c;
        }

    .ed-search {
        max-width: 260px;
        width: 100%;
    }

        .ed-search input {
            width: 100%;
        }

    /* Visual refresh */
    :root {
        --ed-orange: #f97316;
        --ed-orange-dark: #ea580c;
        --ed-ink: #172033;
        --ed-muted: #64748b;
        --ed-line: #e8edf3;
    }

    #employer-dashboard {
        background: #fff !important;
    }

        #employer-dashboard .section-label {
            color: var(--ed-orange);
            font-weight: 800;
            letter-spacing: .13em;
        }

        #employer-dashboard .section-title {
            color: #111827;
            letter-spacing: -.045em;
        }

        #employer-dashboard .section-subtitle {
            color: #64748b;
        }

    .ed-heading {
        margin-bottom: 2rem;
    }

        .ed-heading > .btn,
        .ed-primary-btn,
        .ed-form-actions .btn-primary,
        .ed-btn.primary {
            background: var(--ed-orange) !important;
            border: 1px solid var(--ed-orange) !important;
            color: #fff !important;
            box-shadow: 0 7px 18px rgba(249,115,22,.2);
            font-weight: 700;
            transition: transform .18s ease,box-shadow .18s ease,background .18s ease;
        }

            .ed-heading > .btn:hover,
            .ed-primary-btn:hover,
            .ed-form-actions .btn-primary:hover,
            .ed-btn.primary:hover {
                background: var(--ed-orange-dark) !important;
                border-color: var(--ed-orange-dark) !important;
                color: #fff !important;
                transform: translateY(-2px);
                box-shadow: 0 10px 22px rgba(249,115,22,.28);
            }

    .ed-stats {
        gap: 1.1rem;
    }

    .ed-stat {
        background: #fff !important;
        border: 1px solid #e9edf2 !important;
        border-radius: 16px !important;
        box-shadow: 0 5px 20px rgba(15,23,42,.045);
        transition: transform .2s ease,box-shadow .2s ease;
    }

        .ed-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(15,23,42,.08);
        }

    .ed-stat-top {
        color: #64748b !important;
        font-weight: 600;
    }

    .ed-stat-icon {
        background: #fff1e8 !important;
        color: var(--ed-orange);
    }

    .ed-stat strong {
        color: #111827 !important;
    }

    .ed-stat small {
        color: #788397 !important;
    }

    .ed-panel {
        background: #fff !important;
        border: 1px solid #e7ebf0 !important;
        border-radius: 18px !important;
        box-shadow: 0 10px 35px rgba(15,23,42,.055);
    }

    .ed-tabs {
        background: #fff;
        border-bottom: 1px solid #edf0f4 !important;
        padding: .85rem 1rem .7rem;
        gap: .45rem;
    }

    /* Links navigate to separate pages; they are not dashboard tabs. */
    .ed-tabs-separator {
        flex: 0 0 1px;
        height: 30px;
        margin: 0 .8rem 0 1rem;
        background: #e5e7eb;
    }

    .ed-tab-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        white-space: nowrap;
        text-decoration: none;
        color: #64748b;
        border-radius: 10px;
        padding: .82rem 1.05rem;
        font: 700 .92rem 'DM Sans',sans-serif;
        transition: color .18s ease, background .18s ease;
    }

        .ed-tab-link:hover {
            color: #ea580c;
            background: #fff7f1;
        }

        .ed-tab-link:focus-visible {
            outline: 3px solid rgba(249,115,22,.35);
            outline-offset: 2px;
        }

    .ed-tab {
        position: relative;
        color: #64748b !important;
        border-radius: 10px !important;
        padding: .82rem 1.05rem !important;
        font-weight: 700 !important;
        transition: color .18s ease,background .18s ease;
    }

        .ed-tab:hover {
            color: var(--ed-orange) !important;
            background: #fff7f1 !important;
        }

        .ed-tab.active {
            color: #ea580c !important;
            background: #fff1e8 !important;
        }

            .ed-tab.active::after {
                content: "";
                position: absolute;
                height: 3px;
                left: 14px;
                right: 14px;
                bottom: -.72rem;
                border-radius: 3px 3px 0 0;
                background: var(--ed-orange);
            }

    .ed-view {
        background: #fff;
    }

    .ed-view-head h2 {
        color: #111827 !important;
    }

    .ed-view-head p {
        color: #718096 !important;
    }

    .ed-job {
        background: #fff;
        border: 1px solid #e8edf3 !important;
        border-radius: 13px !important;
        padding: 1.05rem 1.1rem !important;
        transition: border-color .18s ease,box-shadow .18s ease,transform .18s ease;
    }

        .ed-job:hover {
            border-color: #fdc49f !important;
            box-shadow: 0 7px 20px rgba(15,23,42,.055);
            transform: translateY(-1px);
        }

    .ed-job-icon {
        background: #fff3eb !important;
        color: var(--ed-orange);
    }

    .ed-job-copy h3 {
        color: #172033 !important;
    }

    .ed-job-copy p, .ed-meta span {
        color: #718096 !important;
    }

    .ed-meta strong {
        color: #263247 !important;
    }

    .ed-status {
        background: #eaf8ef !important;
        color: #168044 !important;
    }

        .ed-status.closed {
            background: #f1f4f8 !important;
            color: #64748b !important;
        }

        .ed-status.pending {
            background: #fff6df !important;
            color: #9a6700 !important;
        }

    .ed-btn {
        background: #fff !important;
        border: 1px solid #dfe5ec !important;
        color: #344054 !important;
        font-weight: 700 !important;
        transition: all .18s ease;
    }

        .ed-btn:hover {
            background: #fff5ee !important;
            border-color: #f7a36e !important;
            color: #ea580c !important;
        }

        .ed-btn.danger {
            color: #b42318 !important;
        }

            .ed-btn.danger:hover {
                background: #fff1f0 !important;
                border-color: #fda29b !important;
                color: #b42318 !important;
            }

    .ed-form-card, .ed-side-card {
        background: #fff !important;
        border: 1px solid #e8edf3 !important;
        border-radius: 15px !important;
        box-shadow: 0 5px 20px rgba(15,23,42,.035);
    }

        .ed-form-card h3, .ed-side-card h3 {
            color: #172033 !important;
        }

        .ed-form-card label {
            color: #344054 !important;
            font-weight: 700;
        }

        .ed-form-card input,
        .ed-form-card select,
        .ed-form-card textarea {
            background: #fff !important;
            color: #172033 !important;
            border: 1px solid #d8e0e9 !important;
            border-radius: 9px !important;
            box-shadow: none !important;
        }

            .ed-form-card input:focus,
            .ed-form-card select:focus,
            .ed-form-card textarea:focus {
                border-color: var(--ed-orange) !important;
                outline: 3px solid rgba(249,115,22,.13);
            }

            .ed-form-card input::placeholder,
            .ed-form-card textarea::placeholder {
                color: #a0aaba !important;
            }

        .ed-form-card .form-hint {
            color: #778397 !important;
        }

    .ed-form-actions .btn-outline {
        border: 1px solid #d8e0e9 !important;
        color: #344054 !important;
        background: #fff !important;
        font-weight: 700;
    }

        .ed-form-actions .btn-outline:hover {
            border-color: var(--ed-orange) !important;
            color: var(--ed-orange) !important;
            background: #fff7f1 !important;
        }

    .ed-preview {
        background: #fffaf6 !important;
        border-color: #ffdfca !important;
    }

    .ed-preview-tag {
        background: #fff !important;
        border-color: #f4d8c7 !important;
        color: #8b4b25 !important;
    }

    .ed-preview-title {
        color: #172033 !important;
    }

    .ed-preview-pay {
        color: #344054 !important;
        font-weight: 700;
    }

    .ed-empty {
        background: #fff !important;
        border-color: #dfe5ec !important;
    }

        .ed-empty strong {
            color: #172033 !important;
        }

    .ed-message.success {
        background: #ecfdf3 !important;
        color: #067647 !important;
        border: 1px solid #abefc6;
    }

    .ed-message.error {
        background: #fff1f0 !important;
        color: #b42318 !important;
        border: 1px solid #fecdca;
    }

    /* Responsive layout */
    #employer-dashboard,
    #employer-dashboard * {
        box-sizing: border-box;
    }

    #employer-dashboard {
        width: 100%;
        min-width: 0;
        overflow-x: clip;
        padding-left: 0;
        padding-right: 0;
    }

        #employer-dashboard .ed-wrap {
            width: min(100% - 2rem, 1440px);
            max-width: 1440px;
            margin-inline: auto;
        }

        #employer-dashboard .ed-panel,
        #employer-dashboard .ed-view,
        #employer-dashboard .ed-form-layout,
        #employer-dashboard .ed-form-card,
        #employer-dashboard .ed-side-card,
        #employer-dashboard .ed-job-list {
            min-width: 0;
        }

        #employer-dashboard .ed-stats {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        #employer-dashboard .ed-form-layout {
            grid-template-columns: minmax(0, 1.65fr) minmax(260px, .85fr);
        }

        #employer-dashboard .ed-form-card .form-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        #employer-dashboard .ed-form-card .form-group,
        #employer-dashboard .ed-form-card input,
        #employer-dashboard .ed-form-card select,
        #employer-dashboard .ed-form-card textarea {
            width: 100%;
            min-width: 0;
        }

        #employer-dashboard .ed-form-card input,
        #employer-dashboard .ed-form-card select,
        #employer-dashboard .ed-form-card textarea,
        #employer-dashboard .ed-search input {
            min-height: 44px;
            font-size: 16px;
        }

        #employer-dashboard .ed-form-card textarea {
            min-height: 140px;
        }

        #employer-dashboard .ed-job,
        #employer-dashboard .ed-job-main,
        #employer-dashboard .ed-job-copy,
        #employer-dashboard .ed-job-meta,
        #employer-dashboard .ed-actions {
            min-width: 0;
        }

            #employer-dashboard .ed-actions .ed-btn,
            #employer-dashboard button {
                touch-action: manipulation;
            }

        #employer-dashboard .ed-tabs {
            overscroll-behavior-x: contain;
            -webkit-overflow-scrolling: touch;
        }

        #employer-dashboard .ed-tab {
            flex: 0 0 auto;
        }

        #employer-dashboard .ed-preview,
        #employer-dashboard .ed-job-copy,
        #employer-dashboard .ed-meta {
            overflow-wrap: anywhere;
            word-break: normal;
        }

    @@media (max-width: 1100px) {
        #employer-dashboard .ed-wrap {
            width: min(100% - 2rem, 100%);
        }

        #employer-dashboard .ed-form-layout {
            grid-template-columns: minmax(0, 1fr);
        }

        #employer-dashboard .ed-form-sidebar {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 1rem;
        }

        #employer-dashboard .ed-side-card + .ed-side-card {
            margin-top: 0;
        }
    }

    @@media (max-width: 900px) {
        #employer-dashboard .ed-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        #employer-dashboard .ed-job {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: start;
        }

        #employer-dashboard .ed-job-main {
            grid-column: 1 / -1;
        }

        #employer-dashboard .ed-job-meta {
            justify-content: flex-start;
        }

        #employer-dashboard .ed-actions {
            justify-content: flex-end;
        }
    }

    @@media (max-width: 640px) {
        #employer-dashboard {
            padding-top: calc(var(--nav-height, 72px) + 1rem);
            padding-bottom: 2rem;
        }

            #employer-dashboard .ed-wrap {
                width: calc(100% - 1.25rem);
            }

            #employer-dashboard .ed-heading {
                display: flex;
                flex-direction: column;
                align-items: stretch;
                gap: 1rem;
                margin-bottom: 1.25rem;
            }

