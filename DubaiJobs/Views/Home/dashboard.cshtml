        function readCompanyInformation() {
            try {
                const saved = localStorage.getItem(COMPANY_STORAGE_KEY);
                if (saved) {
                    const parsed = JSON.parse(saved);
                    companyInformation = {
                        companyName: parsed.companyName || '',
                        companyLogo: parsed.companyLogo || '',
                        companyWebsite: parsed.companyWebsite || '',
                        contactEmail: parsed.contactEmail || ''
                    };
                }
            } catch (error) {
                console.warn('Could not read saved company information.', error);
            }

            return companyInformation;
        }

        function saveCompanyInformation(data, showFeedback = false) {
            companyInformation = {
                companyName: (data.companyName || '').trim(),
                companyLogo: (data.companyLogo || '').trim(),
                companyWebsite: (data.companyWebsite || '').trim(),
                contactEmail: (data.contactEmail || '').trim()
            };

            try {
                localStorage.setItem(COMPANY_STORAGE_KEY, JSON.stringify(companyInformation));
                fillCompanyInformationForm();

                if (showFeedback) {
                    showCompanyMessage('Company information saved. It will be used for future job postings.', 'success');
                }
                return true;
            } catch (error) {
                console.error('Saving company information failed:', error);
                if (showFeedback) {
                    showCompanyMessage('Could not save company information in this browser. Check browser storage settings.', 'error');
                }
                return false;
            }
        }

        function fillCompanyInformationForm() {
            if (!$('savedCompanyName')) return;
            $('savedCompanyName').value = companyInformation.companyName;
            $('savedCompanyLogo').value = companyInformation.companyLogo;
            $('savedCompanyWebsite').value = companyInformation.companyWebsite;
            $('savedContactEmail').value = companyInformation.contactEmail;

            $('companyName').value = companyInformation.companyName;
            $('companyLogo').value = companyInformation.companyLogo;
            $('companyWebsite').value = companyInformation.companyWebsite;
            $('contactEmail').value = companyInformation.contactEmail;

            if (typeof updatePreview === 'function') updatePreview();
        }

        function showCompanyMessage(message, type) {
            const box = $('companyMessage');
            if (!box) return;
            box.textContent = message;
            box.className = 'ed-message show ' + type;
        }

        const fields = [
            'jobTitle',
            'department',
            'employmentType',
            'workplace',
            'location',
            'salaryMin',
            'salaryMax',
            'description',
            'companyName',
            'companyLogo',
            'companyWebsite',
            'contactEmail',
            'expiry',
            'category',
            'skills'
        ];

        let jobs = [];
        let isSaving = false;
        let applications = [];
        let applicationsLoaded = false;

        // Anti-forgery token
        function getToken() {
            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            return token ? token.value : '';
        }

        // Common request headers
        function getHeaders(json = true) {
            const headers = {
                'RequestVerificationToken': getToken()
            };

            if (json) {
                headers['Content-Type'] = 'application/json';
            }

            return headers;
        }

        // Common API request handler
        async function apiRequest(url, method = 'GET', data = null) {
            const options = {
                method: method,
                credentials: 'same-origin',
                headers: getHeaders(data !== null)
            };

            if (data !== null) {
                options.body = JSON.stringify(data);
            }

            const response = await fetch(url, options);

            const contentType = response.headers.get('content-type') || '';

            let result = null;

            if (contentType.includes('application/json')) {
                result = await response.json();
            } else {
                result = await response.text();
            }

            if (!response.ok) {
                let message = 'Something went wrong. Please try again.';

                if (result && typeof result === 'object') {
                    message = result.message || result.title || message;
                } else if (typeof result === 'string' && result.trim()) {
                    message = result;
                }

                if (response.status === 401 || response.status === 403) {
                    message = 'Your session may have expired. Please sign in again.';
                }

                throw new Error(message);
            }

            return result;
        }

        // Prevent HTML injection
        function escapeHTML(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[ch]));
        }

        // Format salary
        function money(value) {
            if (value === '' || value === null || value === undefined) {
                return 'Not specified';
            }

            return new Intl.NumberFormat(undefined, {
                maximumFractionDigits: 0
            }).format(Number(value));
        }

        // Format relative date
        function dateLabel(value) {
            if (!value) return 'Date unavailable';

            const postedDate = new Date(value);

            if (Number.isNaN(postedDate.getTime())) {
                return 'Date unavailable';
            }

            const days = Math.max(
                0,
                Math.floor((Date.now() - postedDate.getTime()) / 86400000)
            );

            if (days === 0) return 'Today';
            if (days === 1) return '1 day ago';

            if (days < 7) return days + ' days ago';

            if (days < 30) {
                const weeks = Math.floor(days / 7);
                return weeks + (weeks === 1 ? ' week ago' : ' weeks ago');
            }

            const months = Math.floor(days / 30);
            return months + (months === 1 ? ' month ago' : ' months ago');
        }

        // Format application date
        function applicationDateLabel(value) {
            if (!value) return 'Date unavailable';

            const date = new Date(value);

            if (Number.isNaN(date.getTime())) {
                return 'Date unavailable';
            }

            return date.toLocaleDateString(undefined, {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
            });
        }

        // Display messages
        function showMessage(message, type) {
            const box = $('formMessage');

            if (!box) return;

            box.textContent = message;
            box.className = 'ed-message show ' + type;

            box.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest'
            });
        }

        function hideMessage() {
            const box = $('formMessage');

            if (!box) return;

            box.className = 'ed-message';
            box.textContent = '';
        }

        // ==========================================
        // NAVIGATION TO APPLICANTS PAGE
        // ==========================================

        function openApplicantsPage(jobId) {
            if (!jobId) {
                alert('Unable to identify this job.');
                return;
            }

            window.location.href = API.applicants(jobId);
        }

        // Switch dashboard tabs
        function setView(name) {
            document.querySelectorAll('.ed-tab[data-view]').forEach(tab => {
                const active = tab.dataset.view === name;

                tab.classList.toggle('active', active);
                tab.setAttribute('aria-selected', String(active));
                tab.tabIndex = active ? 0 : -1;
            });

            document.querySelectorAll('.ed-view').forEach(view => {
                const active = view.id === 'view-' + name;

                view.classList.toggle('active', active);
                view.hidden = !active;
            });

            if (name === 'posted' || name === 'overview') {
                renderJobs();
            }

            if (name === 'applied') {
                loadAppliedJobs();
            }

            if (name === 'post') {
                fillCompanyInformationForm();
                $('jobTitle').focus({ preventScroll: true });
            }

            if (name === 'company') {
                readCompanyInformation();
                fillCompanyInformationForm();
            }
        }

        // Tab click events
        document.querySelectorAll('.ed-tab[data-view]').forEach(tab => {
            tab.addEventListener('click', () => {
                setView(tab.dataset.view);
            });
        });

        // Open dashboard views
        document.querySelectorAll('[data-open-view]').forEach(button => {
            button.addEventListener('click', () => {
                if (button.dataset.openView === 'post') {
                    resetForm();
                }

                setView(button.dataset.openView);
            });
        });

        // Load stored company information and support save/update.
        readCompanyInformation();

        companyForm.addEventListener('submit', event => {
            event.preventDefault();

            const data = {
                companyName: $('savedCompanyName').value.trim(),
                companyLogo: $('savedCompanyLogo').value.trim(),
                companyWebsite: $('savedCompanyWebsite').value.trim(),
                contactEmail: $('savedContactEmail').value.trim()
            };

            if (!data.companyName || !data.contactEmail) {
                showCompanyMessage('Company name and recruitment contact email are required.', 'error');
                return;
            }

            if (saveCompanyInformation(data, true)) {
                $('companyName').value = data.companyName;
                $('companyLogo').value = data.companyLogo;
                $('companyWebsite').value = data.companyWebsite;
                $('contactEmail').value = data.contactEmail;
                updatePreview();
            }
        });

        $('editCompanyBtn').addEventListener('click', () => {
            $('savedCompanyName').focus();
        });

        // ==========================================
        // JOB CARD
        // ==========================================

        function jobCard(job) {
            const closed = job.status === 'Closed';

            return `
                            <article class="ed-job">

                                <div class="ed-job-main">
                                    <div class="ed-job-icon">💼</div>

                                    <div class="ed-job-copy">
                                        <h3>${escapeHTML(job.jobTitle)}</h3>
                                        <p>
                                            ${escapeHTML(job.companyName)}
                                            ·
                                            ${escapeHTML(job.location || 'Location not specified')}
                                        </p>
                                    </div>
                                </div>

                                <div class="ed-job-meta">

                                    <div class="ed-meta">
                                        <span>Posted</span>
                                        <strong>${dateLabel(job.postedAt)}</strong>
                                    </div>

                                    <div class="ed-meta">
                                        <span>Applicants</span>
                                        <strong>${Number(job.applicants) || 0}</strong>
                                    </div>

                                    <div class="ed-meta">
                                        <span>Status</span>
                                        <strong class="ed-status ${closed ? 'closed' : ''}">
                                            ${closed ? 'Closed' : 'Active'}
                                        </strong>
                                    </div>

                                </div>

                                <div class="ed-actions">

                                    <button class="btn"
                                            type="button"
                                            data-action="applicants"
                                            data-id="${escapeHTML(job.id)}">
                                        View All Applicants
                                    </button>

                                    <button class="ed-btn"
                                            type="button"
                                            data-action="edit"
                                            data-id="${escapeHTML(job.id)}">
                                        Edit
                                    </button>

                                    <button class="ed-btn"
                                            type="button"
                                            data-action="toggle"
                                            data-id="${escapeHTML(job.id)}">
                                        ${closed ? 'Reopen' : 'Close'}
                                    </button>

                                    <button class="ed-btn danger"
                                            type="button"
                                            data-action="delete"
                                            data-id="${escapeHTML(job.id)}">
                                        Delete
                                    </button>

                                </div>
                            </article>
                        `;
        }

        // Render jobs and statistics
        function renderJobs() {
            const query = ($('jobSearch')?.value || '')
                .trim()
                .toLowerCase();

            const filtered = jobs.filter(job => {
                const searchable = [
                    job.jobTitle,
                    job.companyName,
                    job.location,
                    job.category,
                    job.department
                ].join(' ').toLowerCase();

                return searchable.includes(query);
            });

            $('postedJobs').innerHTML = filtered.length
                ? filtered.map(jobCard).join('')
                : `
                                <div class="ed-empty">
                                    <strong>No jobs found</strong>
                                    Try another search or post a new job.
                                </div>
                            `;

            const recent = [...jobs]
                .sort((a, b) =>
                    new Date(b.postedAt).getTime() -
                    new Date(a.postedAt).getTime()
                )
                .slice(0, 3);

            $('recentJobs').innerHTML = recent.length
                ? recent.map(jobCard).join('')
                : `
                                <div class="ed-empty">
                                    <strong>No jobs posted yet</strong>
                                    Create your first job listing to get started.
                                </div>
                            `;

            const activeJobs = jobs.filter(
                job => job.status === 'Active'
            ).length;

            const closedJobs = jobs.filter(
                job => job.status === 'Closed'
            ).length;

            const applicantsCount = jobs.reduce(
                (total, job) => total + (Number(job.applicants) || 0),
                0
            );

            $('statActive').textContent = activeJobs;
            $('statClosed').textContent = closedJobs;
            $('statApplicants').textContent = applicantsCount;
        }

        // Load posted jobs from database
        async function loadJobs() {
            $('postedJobs').innerHTML = `
                            <div class="ed-empty">Loading your jobs...</div>
                        `;

            $('recentJobs').innerHTML = `
                            <div class="ed-empty">Loading your jobs...</div>
                        `;

            try {
                const result = await apiRequest(API.myJobs);

                jobs = Array.isArray(result) ? result : [];

                renderJobs();
            } catch (error) {
                console.error('Loading jobs failed:', error);

                $('postedJobs').innerHTML = `
                                <div class="ed-empty">
                                    <strong>Unable to load jobs</strong>
                                    ${escapeHTML(error.message)}
                                </div>
                            `;

                $('recentJobs').innerHTML = `
                                <div class="ed-empty">
                                    <strong>Unable to load recent jobs</strong>
                                </div>
                            `;
            }
        }

        // ==========================================
        // MY APPLICATIONS
        // ==========================================

        function getApplicationStatusClass(status) {
            const value = (status || '').toLowerCase();

            if (
                value.includes('reject') ||
                value.includes('withdraw') ||
                value.includes('closed')
            ) {
                return 'closed';
            }

            if (
                value.includes('review') ||
                value.includes('pending')
            ) {
                return 'pending';
            }

            return '';
        }

        // Build application card
        function applicationCard(application) {
            const status = application.status || 'Under Review';
            const statusClass = getApplicationStatusClass(status);

            return `
                            <article class="ed-job">

                                <div class="ed-job-main">
                                    <div class="ed-job-icon">💼</div>

                                    <div class="ed-job-copy">
                                        <h3>${escapeHTML(application.jobTitle || 'Untitled Job')}</h3>

                                        <p>
                                            ${escapeHTML(application.companyName || 'Company not available')}
                                            ·
                                            ${escapeHTML(application.location || 'Location not specified')}
                                        </p>
                                    </div>
                                </div>

                                <div class="ed-job-meta">

                                    <div class="ed-meta">
                                        <span>Employment</span>
                                        <strong>
                                            ${escapeHTML(application.employmentType || 'Not specified')}
                                        </strong>
                                    </div>

                                    <div class="ed-meta">
                                        <span>Workplace</span>
                                        <strong>
                                            ${escapeHTML(application.workplace || 'Not specified')}
                                        </strong>
                                    </div>

                                    <div class="ed-meta">
                                        <span>Applied on</span>
                                        <strong>
                                            ${escapeHTML(applicationDateLabel(application.appliedAt))}
                                        </strong>
                                    </div>

                                    <div class="ed-meta">
                                        <span>Status</span>
                                        <strong class="ed-status ${statusClass}">
                                            ${escapeHTML(status)}
                                        </strong>
                                    </div>

                                </div>

                            </article>
                        `;
        }

        // Load applications belonging to the logged-in user
        async function loadAppliedJobs() {
            const container = $('appliedJobs');

            if (!container) return;

            container.innerHTML = `
                            <div class="ed-empty">Loading your applications...</div>
                        `;

            try {
                const result = await apiRequest(API.myApplications);

                applications = Array.isArray(result) ? result : [];
                applicationsLoaded = true;

                $('statApplicationsSent').textContent = applications.length;

                if (applications.length === 0) {
                    container.innerHTML = `
                                    <div class="ed-empty">
                                        <strong>No applications found</strong>
                                        You have not applied for any jobs yet.
                                        Jobs you apply for will appear here.
                                    </div>
                                `;
                    return;
                }

                container.innerHTML = applications
                    .map(applicationCard)
                    .join('');

            } catch (error) {
                applicationsLoaded = false;

                console.error('Loading applications failed:', error);

                container.innerHTML = `
                                <div class="ed-empty">
                                    <strong>Unable to load applications</strong>
                                    ${escapeHTML(error.message)}
                                    <br><br>
                                    <button type="button"
                                            class="ed-btn primary"
                                            id="retryApplicationsBtn">
                                        Try again
                                    </button>
                                </div>
                            `;
            }
        }

        // Retry loading applications
        document.addEventListener('click', event => {
            if (event.target.closest('#retryApplicationsBtn')) {
                loadAppliedJobs();
            }
        });

        // ==========================================
        // RESET AND EDIT JOB FORM
        // ==========================================

        function resetForm() {
            form.reset();
            readCompanyInformation();
            fillCompanyInformationForm();

            $('editingJobId').value = '';

            $('formHeading').textContent = 'Post a new job';
            $('publishBtn').textContent = 'Publish job';

            $('cancelEditBtn').hidden = true;
            $('publishBtn').disabled = false;

            hideMessage();
            updatePreview();
        }

        $('resetFormBtn').addEventListener('click', resetForm);

        $('cancelEditBtn').addEventListener('click', () => {
            resetForm();
            setView('posted');
        });

        // Edit existing job
        function editJob(id) {
            const job = jobs.find(
                item => String(item.id) === String(id)
            );

            if (!job) return;

            $('jobTitle').value = job.jobTitle || '';
            $('department').value = job.department || '';
            $('employmentType').value = job.employmentType || '';
            $('workplace').value = job.workplace || '';
            $('location').value = job.location || '';

            $('salaryMin').value = job.salaryMin ?? '';
            $('salaryMax').value = job.salaryMax ?? '';

            $('description').value = job.description || '';

            $('companyName').value = job.companyName || '';
            $('companyLogo').value = job.companyLogo || '';
            $('companyWebsite').value = job.companyWebsite || '';
            $('contactEmail').value = job.contactEmail || '';

            saveCompanyInformation({
                companyName: job.companyName || '',
                companyLogo: job.companyLogo || '',
                companyWebsite: job.companyWebsite || '',
                contactEmail: job.contactEmail || ''
            });

            $('expiry').value = job.expiry
                ? new Date(job.expiry).toISOString().slice(0, 10)
                : '';

            $('category').value = job.category || '';
            $('skills').value = job.skills || '';

            $('editingJobId').value = job.id;

            $('formHeading').textContent = 'Edit job listing';
            $('publishBtn').textContent = 'Save changes';
            $('cancelEditBtn').hidden = false;

            hideMessage();
            updatePreview();

            setView('post');

            $('formHeading').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }

        // Close or reopen job
        async function changeJobStatus(job) {
            const newStatus = job.status === 'Closed'
                ? 'Active'
                : 'Closed';

            try {
                await apiRequest(
                    API.changeStatus(job.id),
                    'POST',
                    { status: newStatus }
                );

                await loadJobs();
            } catch (error) {
                alert(error.message);
            }
        }

        // Delete job
        async function deleteJob(job) {
            const confirmed = confirm(
                'Delete "' + job.jobTitle + '"? This cannot be undone.'
            );

            if (!confirmed) return;

            try {
                await apiRequest(
                    API.delete(job.id),
                    'DELETE'
                );

                await loadJobs();

                showMessage(
                    'Job deleted successfully.',
                    'success'
                );
            } catch (error) {
                alert(error.message);
            }
        }

        // ==========================================
        // HANDLE ALL JOB CARD ACTIONS
        // ==========================================

        document.addEventListener('click', async event => {
            const button = event.target.closest('[data-action]');

            if (!button) return;

            const action = button.dataset.action;
            const id = button.dataset.id;

            // View applicants: navigate to separate page
            if (action === 'applicants') {
                openApplicantsPage(id);
                return;
            }

            const job = jobs.find(
                item => String(item.id) === String(id)
            );

            if (!job) return;

            if (action === 'edit') {
                editJob(id);
                return;
            }

            if (action === 'toggle') {
                await changeJobStatus(job);
                return;
            }

            if (action === 'delete') {
                await deleteJob(job);
                return;
            }
        });

        // Search posted jobs
        $('jobSearch').addEventListener('input', renderJobs);

        // ==========================================
        // LIVE JOB PREVIEW
        // ==========================================

        function updatePreview() {
            $('previewTitle').textContent =
                $('jobTitle').value.trim() || 'Your job title';

            const company =
                $('companyName').value.trim() || 'Your company name';

            const location =
                $('location').value.trim() || 'Location';

            $('previewCompany').textContent =
                company + ' · ' + location;

            $('previewType').textContent =
                $('employmentType').value || 'Employment type';

            $('previewWorkplace').textContent =
                $('workplace').value || 'Workplace';

            $('previewCategory').textContent =
                $('category').value || 'Category';

            const min = $('salaryMin').value;
            const max = $('salaryMax').value;

            $('previewSalary').textContent =
                min || max
                    ? (min ? money(min) : '—') +
                    ' – ' +
                    (max ? money(max) : '—')
                    : 'Salary range will appear here';
        }

        fields.forEach(id => {
            const element = $(id);

            if (element) {
                element.addEventListener('input', updatePreview);
                element.addEventListener('change', updatePreview);
            }
        });

        // ==========================================
        // COLLECT FORM VALUES
        // ==========================================

        function collectFormData() {
            return {
                jobTitle: $('jobTitle').value.trim(),
                department: $('department').value.trim(),
                employmentType: $('employmentType').value,
                workplace: $('workplace').value,
                location: $('location').value.trim(),

                salaryMin: Number($('salaryMin').value),
                salaryMax: Number($('salaryMax').value),

                description: $('description').value.trim(),

                companyName: $('companyName').value.trim(),
                companyLogo: $('companyLogo').value.trim(),
                companyWebsite: $('companyWebsite').value.trim(),
                contactEmail: $('contactEmail').value.trim(),

                expiry: $('expiry').value || null,

                category: $('category').value,
                skills: $('skills').value.trim()
            };
        }

        // ==========================================
        // PUBLISH OR UPDATE JOB
        // ==========================================

        form.addEventListener('submit', async event => {
            event.preventDefault();

            if (isSaving) return;
            if (!form.reportValidity()) return;

            const min = Number($('salaryMin').value);
            const max = Number($('salaryMax').value);

            if (min < 0 || max < min) {
                showMessage(
                    'Maximum salary must be greater than or equal to minimum salary.',
                    'error'
                );

                $('salaryMax').focus();
                return;
            }

            if ($('description').value.trim().length < 100) {
                showMessage(
                    'Please add at least 100 characters to the job description.',
                    'error'
                );

                $('description').focus();
                return;
            }

            const data = collectFormData();
            const editingId = $('editingJobId').value;

            // Automatically remember company details when the first job is published.
            // Also refresh saved defaults whenever a job is updated or published.
            saveCompanyInformation(data, false);

            isSaving = true;
            $('publishBtn').disabled = true;
            $('publishBtn').textContent = 'Saving...';

            try {
                if (editingId) {
                    await apiRequest(
                        API.edit(editingId),
                        'PUT',
                        data
                    );
                } else {
                    await apiRequest(
                        API.create,
                        'POST',
                        data
                    );
                }

                await loadJobs();

                resetForm();
                setView('posted');

                showMessage(
                    editingId
                        ? 'Your job listing has been updated successfully.'
                        : 'Your job has been published successfully.',
                    'success'
                );

                $('view-posted').scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });

            } catch (error) {
                console.error('Saving job failed:', error);
                showMessage(error.message, 'error');

            } finally {
                isSaving = false;
                $('publishBtn').disabled = false;

                $('publishBtn').textContent =
                    $('editingJobId').value
                        ? 'Save changes'
                        : 'Publish job';
            }
        });

        // ==========================================
        // INITIALIZE DASHBOARD
        // ==========================================

        readCompanyInformation();
        fillCompanyInformationForm();
        updatePreview();

        loadJobs();

        // Load applications belonging to the logged-in candidate
        loadAppliedJobs();

    })();
</script>
